<Project>
  <ItemGroup>
    <!--
      Force transitive dependency upgrades to patched versions.
      These packages are pulled in indirectly (e.g. via Microsoft.PowerPlatform.Dataverse.Client)
      and are pinned here so every project in the solution uses the safe version.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>
</Project>
