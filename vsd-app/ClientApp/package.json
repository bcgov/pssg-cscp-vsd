{
  "name": "vsd_public_app",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.config.js",
    "build": "ng build",
    "builduat": "ng build --configuration=production --base-href /uat/cvapwebform/",
    "buildprod": "ng build --configuration=production",
    "watch": "ng build --watch",
    "test": "vitest run",
    "lint": "ng lint",
    "format": "prettier --loglevel=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "format-fix": "prettier --loglevel=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "generate:api": "orval --config orval.config.ts",
    "e2e": "playwright test --project=localhost",
    "e2e:dev": "playwright test --project=dev",
    "e2e:test": "playwright test --project=test",
    "e2e:test:headed": "playwright test --project=test --headed",
    "e2e:test:ui": "playwright test --project=test --ui",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "dependencies": {
    "@almothafar/angular-signature-pad": "^10.0.0",
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/material-moment-adapter": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ngrx/signals": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "angular-auth-oidc-client": "^22.0.3",
    "bootstrap": ">=4.1.2",
    "core-js": "^2.4.1",
    "file-saver": "^1.3.8",
    "google-libphonenumber": "^3.2.48",
    "hammerjs": "^2.0.8",
    "moment": "^2.22.2",
    "mygovbc-bootstrap-theme": "^0.4.1",
    "ngx-file-drop": "16.0.0",
    "ngx-mask": "^22.2.5",
    "ngx-spinner": "^22.0.1",
    "rxjs": "^7.4.0",
    "rxjs-compat": "^6.6.7",
    "sass": "^1.108.2",
    "tslib": "^2.9.1",
    "xmlhttprequest": "^1.8.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/language-service": "^22.2.6",
    "@playwright/test": "^1.65.1",
    "@types/lodash": "4.14.168",
    "@types/node": "^22.20.5",
    "orval": "^8.48.0",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.2.0",
    "ts-node": "~7.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "webpack": "^5.112.2"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
