{
  "name": "vsd_public_app",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.config.js",
    "build": "ng build",
    "builduat": "ng build --configuration=production --base-href /uat/cvapwebform/",
    "buildprod": "ng build --configuration=production",
    "watch": "ng build --watch",
    "test": "vitest run",
    "lint": "ng lint",
    "format": "prettier --loglevel=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "format-fix": "prettier --loglevel=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "generate:api": "orval --config orval.config.ts",    
    "e2e": "playwright test --project=localhost",
    "e2e:dev": "playwright test --project=dev",
    "e2e:test": "playwright test --project=test",
    "e2e:test:headed": "playwright test --project=test --headed",
    "e2e:test:ui": "playwright test --project=test --ui",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "dependencies": {
    "@almothafar/angular-signature-pad": "^6.0.0",
    "@angular/animations": "21.1.2",
    "@angular/cdk": "^21.1.2",
    "@angular/common": "21.1.2",
    "@angular/compiler": "21.1.2",
    "@angular/core": "21.1.2",
    "@angular/forms": "21.1.2",
    "@angular/material": "^21.1.2",
    "@angular/material-moment-adapter": "^21.1.2",
    "@angular/platform-browser": "21.1.2",
    "@angular/platform-browser-dynamic": "21.1.2",
    "@angular/platform-server": "21.1.2",
    "@angular/router": "21.1.2",
    "@ngrx/signals": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "angular-auth-oidc-client": "^17.1.0",
    "bootstrap": ">=4.1.2",
    "core-js": "^2.4.1",
    "file-saver": "^1.3.8",
    "google-libphonenumber": "^3.2.2",
    "hammerjs": "^2.0.8",
    "moment": "^2.22.2",
    "moment-timezone": "^0.5.46",
    "mygovbc-bootstrap-theme": "^0.4.1",
    "ngx-bootstrap": "^21.0.1",
    "ngx-file-drop": "16.0.0",
    "ngx-mask": "^17.1.6",
    "ngx-spinner": "^21.0.0",
    "rxjs": "^7.4.0",
    "rxjs-compat": "^6.6.7",
    "sass": "^1.32.13",
    "tslib": "^2.0.0",
    "xmlhttprequest": "^1.8.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.13",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.2",
    "@angular/language-service": "^21.1.2",
    "@playwright/test": "^1.60.0",
    "@types/lodash": "4.14.168",
    "@types/node": "^22.19.19",
    "orval": "^8.5.1",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^4.2.0",
    "ts-node": "~7.0.0",
    "tslint": "~6.1.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.8",
    "webpack": "^5.105.0"
  }
}
